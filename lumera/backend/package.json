{
  "name": "silavu-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "db:reset": "bash test/reset.sh",
    "test:db": "node --test test/db.test.mjs",
    "test:functions": "node --experimental-strip-types --no-warnings --test test/functions.test.mjs",
    "test": "npm run db:reset && npm run test:db && npm run db:reset && npm run test:functions",
    "test:acceptance": "npm run db:reset && node --experimental-strip-types --no-warnings --test --test-concurrency=1 test/acceptance.test.mjs"
  },
  "devDependencies": {
    "pg": "^8.13.1"
  }
}
