# Function secrets for the SILAVU backend. Copy to .env.production ON YOUR OWN
# COMPUTER (never commit it), fill in, then:
#   supabase secrets set --env-file supabase/.env.production
# What each one is: ADMIN_SETUP.md, section 1.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase; do not set them.

BUILD_TOKEN=
GH_TOKEN=
GH_REPO=JoniCoderx/isracard
SITE_URL=https://jonicoderx.github.io/isracard
ADMIN_URL=https://jonicoderx.github.io/isracard/admin/
ALLOWED_ORIGINS=https://jonicoderx.github.io
RATE_SALT=
NOTIFY_TO=concierge@silavu.com

# email: either Resend (preferred) ...
RESEND_API_KEY=
MAIL_FROM=
# ... or FormSubmit (the inbox must have been activated once)
NOTIFY_FORMSUBMIT=off

AUTO_REPLY=off
EXPORT_KEEP_DAYS=35
